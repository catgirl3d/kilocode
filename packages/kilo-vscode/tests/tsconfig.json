{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["node", "bun"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["fixtures/**/*", "../webview-ui/src/assets.d.ts", "../src/agent-manager/friendly-words.d.ts"],
  "exclude": [
    "node_modules",
    // This fixture activates the real extension and therefore pulls the full host graph
    // (autocomplete's web-tree-sitter@0.24.7 typings) into this program, which then breaks
    // kilo-indexing's 0.25.10 named imports under tsgo. It still runs via its unit wrapper.
    "fixtures/extension-activation-favorites.ts"
  ]
}
