#!/bin/sh
set -e

# fork_change start - commit-time verification guards (mirror of pre-push fast checks)
git_dir="$(git rev-parse --git-dir 2>/dev/null)"
if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then
  echo "[pre-commit] rebase in progress - skipping verification guards"
  exit 0
fi

echo "[pre-commit] format (kilo-vscode)"
bun run --cwd packages/kilo-vscode format
git update-index --again

echo "[pre-commit] forbidden kilocode_change markers"
bun run --cwd packages/kilo-vscode check-kilocode-change

echo "[pre-commit] opencode annotation markers"
bun run script/check-opencode-annotations.ts --worktree

echo "[pre-commit] markdown table padding"
bun run script/check-md-table-padding.ts

echo "[pre-commit] fork annotation audit"
bun run script/fork-audit.ts --worktree
# fork_change end
